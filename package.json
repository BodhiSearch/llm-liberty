{
  "name": "@bodhiapp/llm-liberty",
  "version": "0.0.1",
  "description": "Free your LLM subscription — extract OAuth tokens from provider CLIs (OpenAI, Anthropic, Gemini, Copilot, …) for use in your own apps.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BodhiSearch/llm-liberty"
  },
  "homepage": "https://github.com/BodhiSearch/llm-liberty#readme",
  "bugs": "https://github.com/BodhiSearch/llm-liberty/issues",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "llm-liberty": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write . && prettier --write '**/*.md'",
    "changeset": "changeset",
    "release": "just release",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "clipboardy": "^5.3.1",
    "commander": "^14.0.3",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.4.0+sha256.b6fd0bfda555e7e584ad7e56b30c68b01d5a04f9ee93989f4b93ca8473c49c74"
}
